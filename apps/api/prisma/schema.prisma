// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  orders Order[]
  quickSales QuickSale[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  price       Float?
  stock       Int?
  createdAt   DateTime @default(now())

  variants    ProductVariant[]

  orderItems  OrderItem[]
  quickSaleItems QuickSaleItem[]
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  flavor    String
  price     Float
  stock     Int
  createdAt DateTime @default(now())

  product   Product   @relation(fields: [productId], references: [id])

  orderItems     OrderItem[]
  quickSaleItems QuickSaleItem[]

  @@unique([productId, flavor])
}

model Order {
  id         String    @id @default(uuid())
  clientId   String
  total      Float
  deliveryAt DateTime?
  deliveryHour String?
  status     String
  createdAt  DateTime  @default(now())

  client   Client      @relation(fields: [clientId], references: [id])
  items    OrderItem[]
  payments Payment[]
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String?
  variantId String
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model Payment {
  id      String    @id @default(uuid())
  orderId String
  amount  Float
  method  String
  paidAt  DateTime?

  order Order @relation(fields: [orderId], references: [id])
}

model Reminder {
  id          String   @id @default(uuid())
  message     String
  remindAt    DateTime
  createdAt   DateTime @default(now())
  isCompleted Boolean  @default(false)
}

model QuickSale {
  id        String     @id @default(uuid())
  clientId  String?
  total     Float
  createdAt DateTime   @default(now())

  client    Client?          @relation(fields: [clientId], references: [id])
  items     QuickSaleItem[]
  payments  QuickSalePayment[]
}

model QuickSaleItem {
  id          String   @id @default(uuid())
  quickSaleId String
  productId   String?
  variantId   String
  quantity    Int
  price       Float

  quickSale QuickSale @relation(fields: [quickSaleId], references: [id])
  product   Product?  @relation(fields: [productId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
}

model QuickSalePayment {
  id          String    @id @default(uuid())
  quickSaleId String
  amount      Float
  method      String
  paidAt      DateTime?

  quickSale QuickSale @relation(fields: [quickSaleId], references: [id])
}
